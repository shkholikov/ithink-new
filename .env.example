# Lead intake endpoint (ithink-miniapp /api/site-lead). Every submission creates
# a real amoCRM deal — point local builds at a mock, not at this URL.
NEXT_PUBLIC_LEAD_ENDPOINT=https://miniapp.ithink.uz/api/site-lead

# Cloudflare Turnstile site key. Optional: leave empty to run without a captcha;
# set it together with the endpoint's TURNSTILE_SECRET_KEY to turn it on.
# Cloudflare's always-pass test key for local work: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
